<!doctype html>
<html>
<head>
<meta charset="utf-8"/>
<title>Commercial Invoice {{invoice.number}}</title>
<style>{{{css}}}</style>
</head>
<body class="{{#if (ifPaid invoice.status)}}paid{{else}}draft{{/if}}">
<header class="hdr">
  <div class="brand"><img src="{{tenant.logo_url}}" class="logo"/><div class="brand-meta"><h1>COMMERCIAL INVOICE</h1><small>No: {{invoice.number}} • Date: {{dateFmt invoice.issued_at}}</small></div></div>
  <div class="tenant"><strong>{{tenant.name}}</strong><br/>{{tenant.address.line1}} {{tenant.address.city}}<br/>{{tenant.phone}} • {{tenant.email}}</div>
</header>
<section class="cols">
  <div><h3>Buyer</h3><p><strong>{{buyer.name}}</strong><br/>{{buyer.country}} • {{buyer.email}} • {{buyer.phone}}</p></div>
  <div><h3>Shipment</h3><p>Method: {{shipment.ship_method}} • ETD {{dateFmt shipment.etd}} • ETA {{dateFmt shipment.eta}} • Tracking: {{shipment.tracking_no}}</p></div>
</section>
<section><h3>Vehicle</h3>
<table class="specs">
<tr><th>Stock No</th><td>{{car.stock_no}}</td><th>VIN</th><td>{{car.vin}}</td></tr>
<tr><th>Make/Model</th><td>{{car.make}} {{car.model}} {{car.grade}}</td><th>Year</th><td>{{car.year}}</td></tr>
</table></section>
<section><h3>Amounts (USD)</h3>
<table class="lines">
<tr><th>Description</th><th class="num">Amount (USD)</th></tr>
{{#each invoice.lines}}
<tr><td>{{this.label}}</td><td class="num">{{formatMoney this.amount 'USD'}}</td></tr>
{{/each}}
<tr class="total"><td><strong>Total Due</strong></td><td class="num"><strong>{{formatMoney invoice.total 'USD'}}</strong></td></tr>
</table></section>
<footer><span>Generated by Denuel • Hash: {{doc_hash}}</span></footer>
</body>
</html>

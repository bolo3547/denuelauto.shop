<!doctype html>
<html>
<head>
<meta charset="utf-8"/>
<title>Receipt {{payment.ref}}</title>
<style>{{{css}}}</style>
</head>
<body class="{{#if (ifPaid payment.status)}}paid{{else}}draft{{/if}}">
<header class="hdr"><div class="brand"><img src="{{tenant.logo_url}}" class="logo"/><div class="brand-meta"><h1>RECEIPT</h1><small>Ref: {{payment.ref}} • Date: {{dateFmt payment.received_at}}</small></div></div></header>
<section class="cols">
  <div><h3>Payer</h3><p>{{payer.name}} • {{payer.email}} • {{payer.phone}}</p></div>
  <div><h3>Method</h3><p>{{payment.method}} • {{payment.currency}}</p></div>
</section>
<section><h3>Details</h3>
<table class="lines">
<tr><th>Description</th><th class="num">Amount</th></tr>
<tr><td>{{payment.desc}}</td><td class="num">{{formatMoney payment.amount payment.currency}}</td></tr>
<tr class="total"><td><strong>Total Received</strong></td><td class="num"><strong>{{formatMoney payment.amount payment.currency}}</strong></td></tr>
</table></section>
<footer><span>Generated by Denuel • Hash: {{doc_hash}}</span></footer>
</body>
</html>

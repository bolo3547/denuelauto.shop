<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <title>Proforma Invoice {{proforma.number}}</title>
  <style>{{{css}}}</style>
</head>
<body class="{{#if (ifPaid proforma.status)}}paid{{else}}draft{{/if}}">
  <header class="hdr">
    <div class="brand">
      <img src="{{tenant.logo_url}}" class="logo"/>
      <div class="brand-meta">
        <h1>PROFORMA INVOICE</h1>
        <small>No: {{proforma.number}} • Date: {{dateFmt proforma.issued_at}}</small>
      </div>
    </div>
    <div class="tenant">
      <strong>{{tenant.name}}</strong><br/>
      {{tenant.address.line1}} {{tenant.address.city}}<br/>
      {{tenant.phone}} • {{tenant.email}}
    </div>
  </header>

  <section class="cols">
    <div>
      <h3>Bill To</h3>
      <p><strong>{{buyer.name}}</strong><br/>{{buyer.country}} • {{buyer.email}} • {{buyer.phone}}</p>
    </div>
    <div>
      <h3>Sales/Agent</h3>
      <p>{{#if agent.name}}Agent: {{agent.name}} ({{agent.country}}) — {{agent.email}}{{else}}Direct Sale{{/if}}</p>
    </div>
  </section>

  <section>
    <h3>Vehicle</h3>
    <table class="specs">
      <tr><th>Stock No</th><td>{{car.stock_no}}</td><th>VIN</th><td>{{car.vin}}</td></tr>
      <tr><th>Make/Model</th><td>{{car.make}} {{car.model}} {{car.grade}}</td><th>Year</th><td>{{car.year}}</td></tr>
      <tr><th>Engine</th><td>{{car.engine_cc}} cc</td><th>Mileage</th><td>{{car.mileage_km}} km</td></tr>
      <tr><th>Transmission</th><td>{{car.transmission}}</td><th>Steering</th><td>{{car.steering}}</td></tr>
      <tr><th>Color</th><td>{{car.color_ext}}</td><th>Location</th><td>{{car.location_branch}}</td></tr>
    </table>
  </section>

  <section>
    <h3>Pricing</h3>
    <table class="lines">
      <tr><th>Description</th><th class="num">Amount ({{proforma.currency}})</th></tr>
      <tr><td>FOB Vehicle</td><td class="num">{{formatMoney pricing.fob proforma.currency}}</td></tr>
      {{#if pricing.freight}}<tr><td>Freight ({{port.name}})</td><td class="num">{{formatMoney pricing.freight 'USD'}}</td></tr>{{/if}}
      {{#if pricing.insurance}}<tr><td>Insurance</td><td class="num">{{formatMoney pricing.insurance 'USD'}}</td></tr>{{/if}}
      {{#each pricing.other}}
        <tr><td>{{this.label}}</td><td class="num">{{formatMoney this.amount ../proforma.currency}}</td></tr>
      {{/each}}
      <tr class="total"><td><strong>Total {{#if pricing.cif}}(CIF){{else}}(FOB){{/if}}</strong></td><td class="num"><strong>{{formatMoney totals.grand proforma.currency}}</strong></td></tr>
    </table>
    {{#if port.name}}<small>Port: {{port.name}} ({{port.country}})</small>{{/if}}
  </section>

  <section class="pay">
    <h3>Payment Instructions</h3>
    <p>{{{tenant.bank_instructions_html}}}</p>
    <div class="qr">
      <img src="{{qr_image}}" alt="Pay QR"/>
      <small>Scan to pay / include Proforma No.</small>
    </div>
  </section>

  <section class="terms">
    <h3>Terms</h3>
    <ul>
      <li>Prices valid until {{dateFmt proforma.valid_until}}.</li>
      <li>Goods remain property of seller until fully paid.</li>
      <li>Inspection documents on request.</li>
    </ul>
  </section>

  <footer>
    <span>Generated by Denuel • Hash: {{doc_hash}}</span>
  </footer>
</body>
</html>

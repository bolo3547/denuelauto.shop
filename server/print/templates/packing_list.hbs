<!doctype html>
<html>
<head>
<meta charset="utf-8"/>
<title>Packing List {{shipment.ref}}</title>
<style>{{{css}}}</style>
</head>
<body class="{{#if (ifPaid shipment.is_paid)}}paid{{else}}draft{{/if}}">
<header class="hdr"><div class="brand"><img src="{{tenant.logo_url}}" class="logo"/><div class="brand-meta"><h1>PACKING LIST</h1><small>Ref: {{shipment.ref}} • Date: {{dateFmt now}}</small></div></div></header>
<section class="cols">
  <div><h3>Exporter</h3><p><strong>{{tenant.name}}</strong><br/>{{tenant.address.line1}}, {{tenant.address.city}}<br/>{{tenant.phone}} • {{tenant.email}}</p></div>
  <div><h3>Consignee</h3><p><strong>{{buyer.name}}</strong><br/>{{buyer.country}}<br/>{{buyer.phone}}</p></div>
</section>
<section><h3>Unit</h3>
<table class="specs">
<tr><th>VIN</th><td>{{car.vin}}</td><th>Stock No</th><td>{{car.stock_no}}</td></tr>
<tr><th>Make/Model</th><td>{{car.make}} {{car.model}} {{car.grade}}</td><th>Year</th><td>{{car.year}}</td></tr>
<tr><th>Weight (kg)</th><td>{{shipment.weight_kg}}</td><th>CBM</th><td>{{shipment.cbm}}</td></tr>
</table></section>
<section><h3>Marks & Numbers</h3><p>{{shipment.marks_numbers}}</p></section>
<footer><span>Generated by Denuel • Hash: {{doc_hash}}</span></footer>
</body>
</html>

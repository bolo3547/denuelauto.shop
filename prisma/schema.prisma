generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin_users {
  id           String    @id
  email        String    @unique
  passwordHash String
  fullName     String
  role         String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
}

model affiliate {
  id       String @id
  tenantId String
  name     String
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "Affiliate_tenantId_fkey")

  @@index([tenantId], map: "Affiliate_tenantId_fkey")
}

model affiliateclick {
  id       String @id
  tenantId String
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "AffiliateClick_tenantId_fkey")

  @@index([tenantId], map: "AffiliateClick_tenantId_fkey")
}

model affiliatepayout {
  id       String @id
  tenantId String
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "AffiliatePayout_tenantId_fkey")

  @@index([tenantId], map: "AffiliatePayout_tenantId_fkey")
}

model agentactivitylog {
  id       String @id
  tenantId String
  agentId  String
  agents   agents @relation(fields: [agentId], references: [id], map: "AgentActivityLog_agentId_fkey")
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "AgentActivityLog_tenantId_fkey")

  @@index([agentId], map: "AgentActivityLog_agentId_fkey")
  @@index([tenantId], map: "AgentActivityLog_tenantId_fkey")
}

model agentdeal {
  id                String    @id
  tenantId          String
  agentId           String
  carId             String
  buyerId           String?
  stage             String
  commissionPercent Decimal   @db.Decimal(5, 2)
  commissionAmount  Decimal?  @db.Decimal(12, 2)
  locked            Boolean   @default(false)
  lockedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  agents            agents    @relation(fields: [agentId], references: [id], map: "AgentDeal_agentId_fkey")
  buyers            buyers?   @relation(fields: [buyerId], references: [id], map: "AgentDeal_buyerId_fkey")
  car               car       @relation(fields: [carId], references: [id], map: "AgentDeal_carId_fkey")
  tenant            tenant    @relation(fields: [tenantId], references: [id], map: "AgentDeal_tenantId_fkey")

  @@index([agentId], map: "AgentDeal_agentId_fkey")
  @@index([buyerId], map: "AgentDeal_buyerId_fkey")
  @@index([carId], map: "AgentDeal_carId_fkey")
  @@index([tenantId], map: "AgentDeal_tenantId_fkey")
}

model agents {
  id                  String                @id
  userId              String                @unique
  tenantId            String
  agentCode           String                @unique
  isActive            Boolean               @default(true)
  tier                agents_tier           @default(BRONZE)
  baseCommission      Decimal               @default(0.00) @db.Decimal(5, 2)
  bonusCommission     Decimal               @default(0.00) @db.Decimal(5, 2)
  totalSales          Int                   @default(0)
  totalCommission     Decimal               @default(0.00) @db.Decimal(12, 2)
  totalReferrals      Int                   @default(0)
  name                String?
  email               String?
  phone               String?
  country             String?
  commissionPercent   Decimal?              @db.Decimal(5, 2)
  portalAccess        Boolean               @default(true)
  status              String                @default("ACTIVE")
  skills              Json?
  maxLeadsPerDay      Int?                  @default(10)
  workingHours        Json?
  referralCode        String?               @unique
  joinedAt            DateTime              @default(now())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  agentactivitylog    agentactivitylog[]
  agentdeal           agentdeal[]
  tenant              tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                user                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment         appointment[]
  commissions         commissions[]
  commissionstatement commissionstatement[]
  lead                lead[]
  payment             payment[]
  proformainvoice     proformainvoice[]
  referrals           referrals[]
  sales               sales[]

  @@unique([tenantId, agentCode])
  @@index([tenantId, status])
}

model appointment {
  id       String @id
  tenantId String
  agentId  String
  agents   agents @relation(fields: [agentId], references: [id], map: "Appointment_agentId_fkey")
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "Appointment_tenantId_fkey")

  @@index([agentId], map: "Appointment_agentId_fkey")
  @@index([tenantId], map: "Appointment_tenantId_fkey")
}

model auditlog {
  id         String   @id
  actorType  String
  actorId    String
  tenantId   String
  action     String
  entity     String
  entityId   String
  ip         String?
  ua         String?
  metaJson   Json?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())
  tenant     tenant   @relation(fields: [tenantId], references: [id], map: "AuditLog_tenantId_fkey")

  @@index([tenantId], map: "AuditLog_tenantId_fkey")
}

model backgroundjob {
  id       String @id
  tenantId String
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "BackgroundJob_tenantId_fkey")

  @@index([tenantId], map: "BackgroundJob_tenantId_fkey")
}

model billing_entitlements {
  id          String   @id
  tenantId    String
  modulesJson Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  tenant      tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "billing_entitlements_tenantId_fkey")
}

model billingaccount {
  tenantId   String   @id
  provider   String
  customerId String?
  metaJson   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  tenant     tenant   @relation(fields: [tenantId], references: [id], map: "BillingAccount_tenantId_fkey")
}

model billingsubscription {
  id               String    @id
  tenantId         String
  provider         String
  subscriptionId   String
  planKey          String
  status           String
  currentPeriodEnd DateTime?
  entitlementsJson Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  tenant           tenant    @relation(fields: [tenantId], references: [id], map: "BillingSubscription_tenantId_fkey")

  @@unique([tenantId, subscriptionId], map: "BillingSubscription_tenantId_subscriptionId_key")
}

model branch {
  id        String   @id
  tenantId  String
  name      String
  address   String?
  phone     String?
  email     String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
  tenant    tenant   @relation(fields: [tenantId], references: [id], map: "Branch_tenantId_fkey")
  car       car[]

  @@index([tenantId], map: "Branch_tenantId_fkey")
}

model buyer_inquiries {
  id            String                   @id
  buyerId       String
  tenantId      String
  subject       String
  message       String                   @db.Text
  type          buyer_inquiries_type     @default(GENERAL)
  carId         String?
  response      String?                  @db.Text
  respondedAt   DateTime?
  respondedById String?
  status        buyer_inquiries_status   @default(OPEN)
  priority      buyer_inquiries_priority @default(MEDIUM)
  metadata      Json?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime
  buyers        buyers                   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  car           car?                     @relation(fields: [carId], references: [id])
  user          user?                    @relation(fields: [respondedById], references: [id])
  tenant        tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([buyerId, status])
  @@index([carId])
  @@index([respondedById], map: "buyer_inquiries_respondedById_fkey")
  @@index([tenantId, status])
}

model buyer_notification_settings {
  id                  String   @id
  buyerId             String   @unique
  emailNewCars        Boolean  @default(true)
  emailPriceDrops     Boolean  @default(true)
  emailPromotions     Boolean  @default(false)
  emailInquiryUpdates Boolean  @default(true)
  smsEnabled          Boolean  @default(false)
  smsNewCars          Boolean  @default(false)
  smsPriceDrops       Boolean  @default(false)
  pushEnabled         Boolean  @default(true)
  pushNewCars         Boolean  @default(true)
  pushPriceDrops      Boolean  @default(true)
  pushPromotions      Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  buyers              buyers   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
}

model buyer_reviews {
  id          String   @id
  buyerId     String
  tenantId    String
  rating      Int
  title       String?
  comment     String?  @db.Text
  orderId     String?
  isVerified  Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  buyers      buyers   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  orders      orders?  @relation(fields: [orderId], references: [id])
  tenant      tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([orderId], map: "buyer_reviews_orderId_fkey")
  @@index([tenantId, isPublished])
}

model buyers {
  id                          String                       @id
  email                       String?                      @unique
  firstName                   String?
  lastName                    String?
  phone                       String?
  country                     String?                      @default("Zambia")
  city                        String?
  passwordHash                String?
  emailVerified               Boolean                      @default(false)
  verificationToken           String?
  avatar                      String?
  dateOfBirth                 DateTime?
  gender                      String?
  budget                      Decimal?                     @db.Decimal(12, 2)
  currency                    String                       @default("USD")
  preferredMakes              Json?
  preferredModels             Json?
  isActive                    Boolean                      @default(true)
  isBlacklisted               Boolean                      @default(false)
  tenantId                    String?
  name                        String?
  addressJson                 Json?
  kycDocsJson                 Json?
  lastLoginAt                 DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime
  agentdeal                   agentdeal[]
  buyer_inquiries             buyer_inquiries[]
  buyer_notification_settings buyer_notification_settings?
  buyer_reviews               buyer_reviews[]
  tenant                      tenant?                      @relation(fields: [tenantId], references: [id])
  car_views                   car_views[]
  dealerreview                dealerreview[]
  escrowpayment               escrowpayment[]
  favorites                   favorites[]
  garageentry                 garageentry[]
  hold                        hold[]
  loyaltyaccount              loyaltyaccount[]
  loyaltyevent                loyaltyevent[]
  orders                      orders[]
  payment                     payment[]
  paymentintent               paymentintent[]
  proformainvoice             proformainvoice[]
  review                      review[]
  saved_searches              saved_searches[]
  shipment                    shipment[]
  watchlist                   watchlist[]

  @@index([country])
  @@index([email])
  @@index([isActive])
  @@index([tenantId], map: "buyers_tenantId_fkey")
}

model campaign {
  id       String @id
  tenantId String
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "Campaign_tenantId_fkey")

  @@index([tenantId], map: "Campaign_tenantId_fkey")
}

model car {
  id               String            @id
  tenantId         String
  stockNo          String
  vin              String?
  make             String
  model            String
  grade            String?
  year             Int
  bodyType         String?
  transmission     String?
  drivetrain       String?
  fuelType         String?
  engineCc         Int?
  mileageKm        Int?
  colorExt         String?
  colorInt         String?
  countryOrigin    String?
  locationBranchId String?
  steering         String?
  featuresJson     Json?
  condition        String?           @default("used")
  remarks          String?
  imagesJson       Json?
  videosJson       Json?
  vr360Json        Json?
  priceLocalZmw    Decimal?          @db.Decimal(12, 2)
  priceUsd         Decimal?          @db.Decimal(12, 2)
  predictedPrice   Decimal?          @db.Decimal(12, 2)
  predictedDemand  Int?
  short_code       String?
  status           String
  publishToPublic  Boolean           @default(false)
  publishToExport  Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  agentdeal        agentdeal[]
  buyer_inquiries  buyer_inquiries[]
  branch           branch?           @relation(fields: [locationBranchId], references: [id], map: "Car_locationBranchId_fkey")
  tenant           tenant            @relation(fields: [tenantId], references: [id], map: "Car_tenantId_fkey")
  car_views        car_views[]
  cardimension     cardimension[]
  carimage         carimage[]
  carmedia         carmedia[]
  carvariant       carvariant[]
  carvideo         carvideo[]
  cifcalculation   cifcalculation[]
  favorites        favorites[]
  garageentry      garageentry[]
  hold             hold[]
  inquiry          inquiry[]
  inspection       inspection[]
  lead             lead[]
  orders           orders[]
  payment          payment[]
  proformainvoice  proformainvoice[]
  quote            quote[]
  referrals        referrals[]
  review           review[]
    sales            sales[]
    shipment         shipment[]
    testdrive        testdrive[]
    tradein          tradein[]
    videotour        videotour[]
    watchlist        watchlist[]
    networkListings       networkListing[]
    globalFavorites       globalFavorite[]
    priceRecommendation   aiPriceRecommendation?
    financingApplications financingApplication[]

  @@unique([tenantId, short_code], map: "Car_tenantId_short_code_key")
  @@unique([tenantId, stockNo], map: "Car_tenantId_stockNo_key")
  @@index([locationBranchId], map: "Car_locationBranchId_fkey")
  @@index([tenantId, make, model, year], map: "Car_tenantId_make_model_year_idx")
  @@index([tenantId, publishToExport], map: "Car_tenantId_publishToExport_idx")
  @@index([tenantId, publishToPublic], map: "Car_tenantId_publishToPublic_idx")
  @@index([tenantId, status], map: "Car_tenantId_status_idx")
}

model car_views {
  id        String   @id
  buyerId   String?
  carId     String
  ipAddress String?
  userAgent String?
  source    String?
  sessionId String?
  duration  Int?
  createdAt DateTime @default(now())
  buyers    buyers?  @relation(fields: [buyerId], references: [id])
  car       car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([carId])
  @@index([createdAt])
}

model cardimension {
  id       String  @id
  tenantId String
  carId    String
  cbm      Decimal @db.Decimal(6, 2)
  car      car     @relation(fields: [carId], references: [id], map: "CarDimension_carId_fkey")
  tenant   tenant  @relation(fields: [tenantId], references: [id], map: "CarDimension_tenantId_fkey")

  @@index([carId], map: "CarDimension_carId_fkey")
  @@index([tenantId], map: "CarDimension_tenantId_fkey")
}

model carimage {
  id    String @id
  carId String
  url   String
  car   car    @relation(fields: [carId], references: [id], map: "CarImage_carId_fkey")

  @@index([carId], map: "CarImage_carId_fkey")
}

model carmedia {
  id               String   @id
  tenantId         String?
  carId            String
  type             String
  url              String
  sortNo           Int?
  watermarkApplied Boolean? @default(false)
  metaJson         Json?
  car              car      @relation(fields: [carId], references: [id], map: "CarMedia_carId_fkey")
  tenant           tenant?  @relation(fields: [tenantId], references: [id], map: "CarMedia_tenantId_fkey")

  @@index([carId], map: "CarMedia_carId_fkey")
  @@index([tenantId], map: "CarMedia_tenantId_fkey")
}

model carvariant {
  id    String   @id
  carId String
  name  String
  price Decimal? @db.Decimal(12, 2)
  car   car      @relation(fields: [carId], references: [id], map: "CarVariant_carId_fkey")

  @@index([carId], map: "CarVariant_carId_fkey")
}

model carvideo {
  id    String @id
  carId String
  url   String
  car   car    @relation(fields: [carId], references: [id], map: "CarVideo_carId_fkey")

  @@index([carId], map: "CarVideo_carId_fkey")
}

model cifcalculation {
  id               String   @id
  tenantId         String
  carId            String?
  createdById      String
  customerName     String?
  carValue         Decimal  @db.Decimal(12, 2)
  currency         String   @default("USD")
  originPort       String
  destinationPort  String
  shippingMethod   String   @default("roro")
  freightCost      Decimal  @db.Decimal(12, 2)
  insuranceCost    Decimal  @db.Decimal(12, 2)
  totalCIF         Decimal  @db.Decimal(12, 2)
  handlingFee      Decimal  @default(0.00) @db.Decimal(12, 2)
  documentationFee Decimal  @default(0.00) @db.Decimal(12, 2)
  inspectionFee    Decimal  @default(0.00) @db.Decimal(12, 2)
  dutyRate         Decimal  @default(0.00) @db.Decimal(5, 2)
  vatRate          Decimal  @default(0.00) @db.Decimal(5, 2)
  dutyAmount       Decimal  @default(0.00) @db.Decimal(12, 2)
  vatAmount        Decimal  @default(0.00) @db.Decimal(12, 2)
  totalLandedCost  Decimal  @db.Decimal(12, 2)
  calculatedAt     DateTime @default(now())
  notes            String?
  car              car?     @relation(fields: [carId], references: [id], map: "CIFCalculation_carId_fkey")
  user             user     @relation(fields: [createdById], references: [id], map: "CIFCalculation_createdById_fkey")
  tenant           tenant   @relation(fields: [tenantId], references: [id], map: "CIFCalculation_tenantId_fkey")

  @@index([carId], map: "CIFCalculation_carId_idx")
  @@index([createdById], map: "CIFCalculation_createdById_fkey")
  @@index([tenantId, calculatedAt], map: "CIFCalculation_tenantId_calculatedAt_idx")
}

model cifoverride {
  id       String @id
  tenantId String
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "CifOverride_tenantId_fkey")

  @@index([tenantId], map: "CifOverride_tenantId_fkey")
}

model commissions {
  id               String             @id
  agentId          String
  tenantId         String
  saleId           String
  saleAmount       Decimal            @db.Decimal(12, 2)
  commissionRate   Decimal            @db.Decimal(5, 2)
  commissionAmount Decimal            @db.Decimal(12, 2)
  status           commissions_status @default(PENDING)
  paidAt           DateTime?
  paymentMethod    String?
  transactionRef   String?
  notes            String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  agents           agents             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sales            sales              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  tenant           tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@index([saleId])
  @@index([tenantId, status])
}

model commissionstatement {
  id       String @id
  tenantId String
  agentId  String
  agents   agents @relation(fields: [agentId], references: [id], map: "CommissionStatement_agentId_fkey")
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "CommissionStatement_tenantId_fkey")

  @@index([agentId], map: "CommissionStatement_agentId_fkey")
  @@index([tenantId], map: "CommissionStatement_tenantId_fkey")
}

model consignment {
  id       String @id
  tenantId String
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "Consignment_tenantId_fkey")

  @@index([tenantId], map: "Consignment_tenantId_fkey")
}

model containerquote {
  id       String @id
  tenantId String
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "ContainerQuote_tenantId_fkey")

  @@index([tenantId], map: "ContainerQuote_tenantId_fkey")
}

model containerrule {
  id             String  @id
  tenantId       String
  type           String
  maxCbm         Decimal @db.Decimal(6, 2)
  maxUnits       Int
  baseFreightUsd Decimal @db.Decimal(12, 2)
  tenant         tenant  @relation(fields: [tenantId], references: [id], map: "ContainerRule_tenantId_fkey")

  @@index([tenantId], map: "ContainerRule_tenantId_fkey")
}

model countryguide {
  id           String   @id
  tenantId     String
  countryCode  String
  slug         String
  title        String
  sectionsJson Json
  faqJson      Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  tenant       tenant   @relation(fields: [tenantId], references: [id], map: "CountryGuide_tenantId_fkey")

  @@index([tenantId], map: "CountryGuide_tenantId_fkey")
}

model customdomain {
  id       String @id
  tenantId String
  hostname String @unique(map: "CustomDomain_hostname_key")
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "CustomDomain_tenantId_fkey")

  @@index([tenantId], map: "CustomDomain_tenantId_fkey")
}

model customer {
  id        String   @id
  tenantId  String
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  tenant    tenant   @relation(fields: [tenantId], references: [id], map: "Customer_tenantId_fkey")
  sales     sales[]

  @@index([tenantId], map: "Customer_tenantId_fkey")
}

model dealerreview {
  id       String @id
  tenantId String
  buyerId  String
  buyers   buyers @relation(fields: [buyerId], references: [id], map: "DealerReview_buyerId_fkey")
  tenant   tenant @relation(fields: [tenantId], references: [id], map: "DealerReview_tenantId_fkey")

  @@index([buyerId], map: "DealerReview_buyerId_fkey")
  @@index([tenantId], map: "DealerReview_tenantId_fkey")
}

model entitlements {
  tenantId    String   @id
  modulesJson Json
  updatedAt   DateTime
  tenant      tenant   @relation(fields: [tenantId], references: [id], map: "Entitlements_tenantId_fkey")
}

model escrowpayment {
  id       String  @id
  tenantId String
  buyerId  String
  amount   Decimal @db.Decimal(12, 2)
  status   String  @default("PENDING")
  buyers   buyers  @relation(fields: [buyerId], references: [id], map: "EscrowPayment_buyerId_fkey")
  tenant   tenant  @relation(fields: [tenantId], references: [id], map: "EscrowPayment_tenantId_fkey")

  @@index([buyerId], map: "EscrowPayment_buyerId_fkey")
  @@index([tenantId], map: "EscrowPayment_tenantId_fkey")
}

model exportport {
  id              String            @id
  tenantId        String
  name            String
  country         String?
  tenant          tenant            @relation(fields: [tenantId], references: [id], map: "ExportPort_tenantId_fkey")
  exportpricerule exportpricerule[]

  @@index([tenantId], map: "ExportPort_tenantId_fkey")
}

model exportpricerule {
  id               String     @id
  tenantId         String
  portId           String
  baseUsd          Decimal    @db.Decimal(12, 2)
  freightUsd       Decimal    @db.Decimal(12, 2)
  insuranceRatePct Decimal    @db.Decimal(5, 2)
  exportport       exportport @relation(fields: [portId], references: [id], map: "ExportPriceRule_portId_fkey")
  tenant           tenant     @relation(fields: [tenantId], references: [id], map: "ExportPriceRule_tenantId_fkey")

  @@index([portId], map: "ExportPriceRule_portId_fkey")
  @@index([tenantId], map: "ExportPriceRule_tenantId_fkey")
}

model favorites {
  id        String   @id
  buyerId   String
  carId     String
  tenantId  String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  buyers    buyers   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  car       car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  tenant    tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([buyerId, carId])
  @@index([buyerId])
  @@index([carId])
  @@index([tenantId], map: "favorites_tenantId_fkey")
}


// =====================================================
// NATIONAL NETWORK, GLOBAL BUYER & FINANCING MODELS
// =====================================================

enum NetworkMembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  OPTED_OUT
}

enum NetworkListingStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  EXPIRED
  SUSPENDED
}

enum FeaturedPlacementType {
  HOMEPAGE_BANNER
  SEARCH_TOP
  CATEGORY_FEATURED
  MAKE_SPOTLIGHT
  DEAL_OF_DAY
}

enum BuyerAccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum FinancingPartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  PENDING_APPROVAL
}

enum FinancingApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVIEWING
  APPROVED
  REJECTED
  EXPIRED
  WITHDRAWN
  DISBURSED
  CANCELLED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  REVOKED
}

enum VerificationDocType {
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  TAX_CLEARANCE
  TPIN_CERTIFICATE
  TRADE_LICENSE
  OWNER_ID
  BANK_STATEMENT
  PROOF_OF_ADDRESS
  UTILITY_BILL
  OTHER
}

model networkMembership {
  id                    String                  @id @default(uuid())
  tenantId              String                  @unique
  tenant                tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status                NetworkMembershipStatus @default(PENDING)
  joinedAt              DateTime?
  optedOutAt            DateTime?
  visibilityRank        Int                     @default(100)
  commissionRate        Decimal                 @default(0) @db.Decimal(5, 2)
  agreedTermsAt         DateTime?
  agreedTermsVersion    String?
  monthlyLeadsReceived  Int                     @default(0)
  totalSalesFromNetwork Int                     @default(0)
  reviewedBy            String?
  reviewedAt            DateTime?
  notes                 String?                 @db.Text
  settings              Json?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  networkListings   networkListing[]
  featuredPlacements featuredPlacement[]

  @@index([status], map: "NetworkMembership_status_idx")
  @@index([visibilityRank], map: "NetworkMembership_visibilityRank_idx")
  @@map("network_memberships")
}

model networkListing {
  id                String               @id @default(uuid())
  membershipId      String
  membership        networkMembership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  carId             String
  car               car                  @relation(fields: [carId], references: [id], onDelete: Cascade)
  status            NetworkListingStatus @default(PENDING_REVIEW)
  listPrice         Decimal              @db.Decimal(12, 2)
  currency          String               @default("ZMW")
  viewCount         Int                  @default(0)
  inquiryCount      Int                  @default(0)
  favoriteCount     Int                  @default(0)
  qualityScore      Int?
  boosted           Boolean              @default(false)
  boostExpiresAt    DateTime?
  rejectionReason   String?
  approvedBy        String?
  approvedAt        DateTime?
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  networkInquiries  networkInquiry[]

  @@unique([membershipId, carId], map: "NetworkListing_membershipId_carId_key")
  @@index([status, qualityScore], map: "NetworkListing_status_qualityScore_idx")
  @@index([viewCount], map: "NetworkListing_viewCount_idx")
  @@map("network_listings")
}

model featuredPlacement {
  id           String               @id @default(uuid())
  membershipId String
  membership   networkMembership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  type         FeaturedPlacementType
  carId        String?
  startDate    DateTime
  endDate      DateTime
  amountPaid   Decimal              @db.Decimal(10, 2)
  currency     String               @default("ZMW")
  paymentRef   String?
  impressions  Int                  @default(0)
  clicks       Int                  @default(0)
  conversions  Int                  @default(0)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())

  @@index([type, startDate, endDate], map: "FeaturedPlacement_type_dates_idx")
  @@index([active], map: "FeaturedPlacement_active_idx")
  @@map("featured_placements")
}

model globalBuyer {
  id                String             @id @default(uuid())
  email             String             @unique
  phone             String?
  passwordHash      String?
  fullName          String
  avatarUrl         String?
  status            BuyerAccountStatus @default(ACTIVE)
  emailVerified     Boolean            @default(false)
  phoneVerified     Boolean            @default(false)
  preferredCurrency String             @default("ZMW")
  preferredLanguage String             @default("en")
  notificationPrefs Json?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  loginCount        Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  globalFavorites   globalFavorite[]
  networkInquiries  networkInquiry[]
  carComparisons    carComparison[]
  searchHistory     buyerSearchHistory[]
  priceAlerts       priceAlert[]
  buyerSessions     buyerSession[]
  financingApps     financingApplication[]

  @@index([email], map: "GlobalBuyer_email_idx")
  @@index([phone], map: "GlobalBuyer_phone_idx")
  @@map("global_buyers")
}

model buyerSession {
  id         String      @id @default(uuid())

  id                   String                     @id @default(uuid())
  partnerId            String
  partner              financingPartner           @relation(fields: [partnerId], references: [id])
  globalBuyerId        String?                    @map("buyerId")
  globalBuyer          globalBuyer?               @relation(fields: [globalBuyerId], references: [id])
  tenantId             String
  tenant               tenant                     @relation(fields: [tenantId], references: [id])
  carId                String
  car                  car                        @relation(fields: [carId], references: [id])
  applicantName        String
  applicantEmail       String
  applicantPhone       String
  applicantNrc         String?
  employerName         String?
  employmentStatus     String?
  monthlyIncome        Decimal?                   @db.Decimal(12, 2)
  requestedAmount      Decimal                    @db.Decimal(12, 2)
  requestedTermMonths  Int                        @map("requestedTenure")
  downPayment          Decimal?                   @db.Decimal(12, 2)
  documentsJson        Json?
  status               FinancingApplicationStatus @default(DRAFT)
  partnerRefNo         String?
  approvedAmount       Decimal?                   @db.Decimal(12, 2)
  approvedRate         Decimal?                   @db.Decimal(5, 2)
  approvedTermMonths   Int?                       @map("approvedTenure")
  monthlyPayment       Decimal?                   @db.Decimal(12, 2)
  partnerNotes         String?                    @db.Text @map("notes")
  rejectionReason      String?
  approvedAt           DateTime?
  disbursedAt          DateTime?
  submittedAt          DateTime?
  decidedAt            DateTime?
  expiresAt            DateTime?
  commissionEarned     Decimal?                   @db.Decimal(10, 2)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([partnerId, status], map: "FinancingApplication_partner_status_idx")
  @@index([tenantId, status], map: "FinancingApplication_tenant_status_idx")
  @@index([globalBuyerId], map: "FinancingApplication_buyer_idx")
  @@map("financing_applications")
}

model dealerVerification {
  id              String             @id @default(uuid())
  tenantId        String             @unique
  tenant          tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status          VerificationStatus @default(UNVERIFIED)
  level           String             @default("BASIC")
  verificationLevel Int              @default(0)
  badgeType       String?
  trustScore      Int?
  totalSales      Int                @default(0)
  totalReviews    Int                @default(0)
  avgRating       Decimal?           @db.Decimal(2, 1)
  disputeCount    Int                @default(0)
  lastAuditAt     DateTime?
  verifiedAt      DateTime?
  verifiedBy      String?
  expiresAt       DateTime?
  rejectionReason String?            @db.Text
  suspendedAt     DateTime?
  notes           String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  documents       verificationDocument[]

  @@index([status], map: "DealerVerification_status_idx")
  @@index([trustScore], map: "DealerVerification_trustScore_idx")
  @@map("dealer_verifications")
}

model verificationDocument {
  id              String               @id @default(uuid())
  verificationId  String
  verification    dealerVerification   @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  documentType    VerificationDocType  @map("docType")
  fileName        String
  documentUrl     String               @map("fileUrl")
  fileSize        Int?
  mimeType        String?
  status          String               @default("PENDING")
  reviewedBy      String?
  reviewedAt      DateTime?
  documentNumber  String?
  notes           String?              @db.Text
  reviewNotes     String?              @db.Text
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())

  @@index([verificationId, documentType], map: "VerificationDocument_verification_docType_idx")
  @@map("verification_documents")
}


// Prisma schema for multi-tenant car dealership management system
// DB: MySQL - Cleaned version

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum AgentTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum SaleStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  DISPUTED
  CANCELLED
}

enum BuyerInquiryType {
  GENERAL
  CAR_SPECIFIC
  PRICING
  FINANCING
  SHIPPING
  TECHNICAL
}

enum InquiryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Tenant {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  theme                Json?
  settings             Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  cars                 Car[]
  branches             Branch[]
  leads                Lead[]
  quotes               Quote[]
  proformas            ProformaInvoice[]
  buyers               Buyer[]
  agents               Agent[]
  agentDeals           AgentDeal[]
  payments             Payment[]
  exportPorts          ExportPort[]
  exportRules          ExportPriceRule[]
  shipments            Shipment[]
  testDrives           TestDrive[]
  tradeIns             TradeIn[]
  serviceJobs          ServiceJob[]
  favorites            Favorite[]
  auditLogs            AuditLog[]
  escrowPayments       EscrowPayment[]
  holds                Hold[]
  inspections          Inspection[]
  reviews              Review[]
  affiliates           Affiliate[]
  affiliateClicks      AffiliateClick[]
  affiliatePayouts     AffiliatePayout[]
  consignments         Consignment[]
  fxSetting            FxSetting?
  shippingTimelines    ShippingTimeline[]
  commissionStatements CommissionStatement[]
  backgroundJobs       BackgroundJob[]
  ussdChannels         UssdChannel[]
  ussdAudits           UssdAudit[]
  watchlists           Watchlist[]
  savedSearches        SavedSearch[]
  users                User[]
  paymentIntents       PaymentIntent[]
  billingAccount       BillingAccount?
  billingSubscriptions BillingSubscription[]
  usageMeters          UsageMeter[]
  entitlements         Entitlements?
  invoices             Invoice[]
  customDomains        CustomDomain[]
  warrantySelections   WarrantySelection[]
  loyaltyAccounts      LoyaltyAccount[]
  loyaltyEvents        LoyaltyEvent[]
  pushSubscriptions    PushSubscription[]
  campaigns            Campaign[]
  containerRules       ContainerRule[]
  carDimensions        CarDimension[]
  containerQuotes      ContainerQuote[]
  countryGuides        CountryGuide[]
  garageEntries        GarageEntry[]
  payoutMobileWallets  PayoutMobileWallet[]
  payoutBankAccounts   PayoutBankAccount[]
  subscriptions        TenantSubscription[]
  paymentInvoices      PaymentInvoice[]
  paymentProofs        PaymentProof[]
  tenantTheme          TenantTheme?
  shippingRates        ShippingRate[]
  cifOverrides         CifOverride[]
  shippingEstimateLogs ShippingEstimateLog[]
  parts                Part[]
  partCategories       PartCategory[]
  dealerReviews        DealerReview[]
  promotionBanners     PromotionBanner[]
  hqNotifications      HqNotification[]
  appointments         Appointment[]
  agentActivityLogs    AgentActivityLog[]
  cifCalculations      CIFCalculation[]
  customers            Customer[]
  themes               Theme[]
  referrals            Referral[]
  sales                Sale[]
  commissions          Commission[]
  buyerInquiries       BuyerInquiry[]
  orders               Order[]
  buyerReviews         BuyerReview[]
}

model Car {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  stockNo          String
  vin              String?
  make             String
  model            String
  grade            String?
  year             Int
  bodyType         String?
  transmission     String?
  drivetrain       String?
  fuelType         String?
  engineCc         Int?
  mileageKm        Int?
  colorExt         String?
  colorInt         String?
  countryOrigin    String?
  locationBranchId String?
  locationBranch   Branch?           @relation(fields: [locationBranchId], references: [id])
  steering         String?
  featuresJson     Json?
  condition        String?           @default("used")
  remarks          String?
  imagesJson       Json?
  videosJson       Json?
  vr360Json        Json?
  priceLocalZmw    Decimal?          @db.Decimal(12, 2)
  priceUsd         Decimal?          @db.Decimal(12, 2)
  predictedPrice   Decimal?          @db.Decimal(12, 2)
  predictedDemand  Int?
  shortCode        String?           @map("short_code")
  status           String
  publishToPublic  Boolean           @default(false)
  publishToExport  Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  media            CarMedia[]
  variants         CarVariant[]
  leads            Lead[]
  quotes           Quote[]
  proformas        ProformaInvoice[]
  agentDeals       AgentDeal[]
  payments         Payment[]
  shipments        Shipment[]
  testDrives       TestDrive[]
  tradeIns         TradeIn[]
  favorites        Favorite[]
  holds            Hold[]
  inspections      Inspection[]
  reviews          Review[]
  dimensions       CarDimension[]
  watchlists       Watchlist[]
  garageEntries    GarageEntry[]
  videoTours       VideoTour[]       @relation("CarToVideoTours")
  images           CarImage[]        @relation("CarImages")
  videos           CarVideo[]        @relation("CarVideos")
  inquiries        Inquiry[]         @relation("CarInquiries")
  cifCalculations  CIFCalculation[]
  referrals        Referral[]
  sales            Sale[]
  buyerInquiries   BuyerInquiry[]
  carViews         CarView[]
  orders           Order[]

  @@unique([tenantId, stockNo])
  @@unique([tenantId, shortCode])
  @@index([tenantId, status])
  @@index([tenantId, make, model, year])
  @@index([tenantId, publishToPublic])
  @@index([tenantId, publishToExport])
}

// Agent System - Single Definition
model Agent {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Agent Profile
  agentCode       String   @unique // Unique referral code
  isActive        Boolean  @default(true)
  tier            AgentTier @default(BRONZE)
  
  // Commission Settings
  baseCommission  Decimal  @default(0) @db.Decimal(5, 2) // Percentage
  bonusCommission Decimal  @default(0) @db.Decimal(5, 2) // Additional percentage for performance
  
  // Performance Metrics
  totalSales      Int      @default(0)
  totalCommission Decimal  @default(0) @db.Decimal(12, 2)
  totalReferrals  Int      @default(0)
  
  // Legacy fields for compatibility
  name            String?
  email           String?
  phone           String?
  country         String?
  commissionPercent Decimal? @db.Decimal(5, 2)
  portalAccess    Boolean  @default(true)
  status          String   @default("ACTIVE")
  skills          Json?
  maxLeadsPerDay  Int?     @default(10)
  workingHours    Json?
  
  // Relations
  referrals       Referral[]
  commissions     Commission[]
  sales           Sale[]
  deals           AgentDeal[]
  proformas       ProformaInvoice[]
  payments        Payment[]
  commissionStatements CommissionStatement[]
  assignedLeads   Lead[]   @relation("AgentLeads")
  appointments    Appointment[]
  activityLogs    AgentActivityLog[]
  
  // Metadata
  joinedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([tenantId, agentCode])
  @@index([tenantId, status])
  @@map("agents")
}

// Buyer System - Single Definition
model Buyer {
  id              String   @id @default(cuid())
  email           String   @unique
  firstName       String
  lastName        String
  phone           String?
  country         String?  @default("Zambia")
  city            String?
  
  // Authentication
  passwordHash    String
  emailVerified   Boolean  @default(false)
  verificationToken String?
  
  // Profile
  avatar          String?
  dateOfBirth     DateTime?
  gender          String?
  
  // Preferences
  budget          Decimal?         @db.Decimal(12, 2)
  currency        String           @default("USD")
  preferredMakes  Json?            // Array of preferred car makes
  preferredModels Json?            // Array of preferred car models
  
  // Status
  isActive        Boolean  @default(true)
  isBlacklisted   Boolean  @default(false)
  
  // Legacy fields for compatibility
  tenantId        String?
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  name            String?
  addressJson     Json?
  kycDocsJson     Json?
  
  // Relations
  notifications   BuyerNotificationSettings?
  favorites       Favorite[]
  inquiries       BuyerInquiry[]
  viewHistory     CarView[]
  searchHistory   SavedSearch[]
  orders          Order[]
  reviews         BuyerReviews[]
  
  // Legacy relations for compatibility
  proformas       ProformaInvoice[]
  payments        Payment[]
  shipments       Shipment[]
  agentDeals      AgentDeal[]
  escrowPayments  EscrowPayment[]
  legacyReviews   Review[]
  holds           Hold[]
  watchlists      Watchlist[]
  paymentIntents  PaymentIntent[]
  loyaltyAccounts LoyaltyAccount[]
  loyaltyEvents   LoyaltyEvent[]
  garageEntries   GarageEntry[]
  dealerReviews   DealerReview[]
  
  // Metadata
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([email])
  @@index([country])
  @@index([isActive])
  @@map("buyers")
}

// Favorite System - Single Definition
model Favorite {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  
  // Legacy compatibility
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  
  // Metadata
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  
  @@unique([buyerId, carId])
  @@index([buyerId])
  @@index([carId])
  @@map("favorites")
}

// SavedSearch System - Single Definition
model SavedSearch {
  id          String   @id @default(cuid())
  buyerId     String?
  buyer       Buyer?   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Search Parameters
  name        String?
  filters     Json     // Search filters as JSON
  queryJson   Json?    // Legacy field
  
  // Notifications
  alertEnabled Boolean @default(false)
  lastAlertAt  DateTime?
  
  // Legacy compatibility
  email       String?
  phone       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([buyerId])
  @@index([tenantId])
  @@map("saved_searches")
}

// Keep all existing models from here...
// I'll continue with the rest of the schema that doesn't have duplicates

model CIFCalculation {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  carId               String?
  car                 Car?     @relation(fields: [carId], references: [id])
  createdById         String
  createdBy           User     @relation(fields: [createdById], references: [id])
  customerName        String?
  
  // Vehicle Details
  carValue            Decimal  @db.Decimal(12, 2)
  currency            String   @default("USD")
  
  // Origin & Destination
  originPort          String
  destinationPort     String
  shippingMethod      String   @default("roro") // roro, container
  
  // CIF Components
  freightCost         Decimal  @db.Decimal(12, 2)
  insuranceCost       Decimal  @db.Decimal(12, 2)
  totalCIF            Decimal  @db.Decimal(12, 2)
  
  // Additional Costs
  handlingFee         Decimal  @default(0) @db.Decimal(12, 2)
  documentationFee    Decimal  @default(0) @db.Decimal(12, 2)
  inspectionFee       Decimal  @default(0) @db.Decimal(12, 2)
  
  // Taxes & Duties
  dutyRate            Decimal  @default(0) @db.Decimal(5, 2) // Percentage
  vatRate             Decimal  @default(0) @db.Decimal(5, 2) // Percentage
  dutyAmount          Decimal  @default(0) @db.Decimal(12, 2)
  vatAmount           Decimal  @default(0) @db.Decimal(12, 2)
  
  // Total Landed Cost
  totalLandedCost     Decimal  @db.Decimal(12, 2)
  
  // Metadata
  calculatedAt        DateTime @default(now())
  notes               String?
  
  @@index([tenantId, calculatedAt])
  @@index([carId])
}

// Continue with existing models (Branch, Lead, Quote, etc.)
// For brevity, I'll include the key models that are referenced

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  address   String?
  phone     String?
  email     String?
  isMain    Boolean  @default(false)
  cars      Car[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  carId         String?
  car           Car?     @relation(fields: [carId], references: [id])
  assignedToId  String?
  assignedTo    Agent?   @relation("AgentLeads", fields: [assignedToId], references: [id])
  name          String
  email         String?
  phone         String?
  budget        Decimal? @db.Decimal(12, 2)
  status        String   @default("NEW")
  source        String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Quote {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  quoteNo   String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  validUntil DateTime
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProformaInvoice {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  buyerId   String?
  buyer     Buyer?   @relation(fields: [buyerId], references: [id])
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  proformaNo String  @unique
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentDeal {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  agentId           String
  agent             Agent     @relation(fields: [agentId], references: [id])
  carId             String
  car               Car       @relation(fields: [carId], references: [id])
  buyerId           String?
  buyer             Buyer?    @relation(fields: [buyerId], references: [id])
  stage             String
  commissionPercent Decimal   @db.Decimal(5, 2)
  commissionAmount  Decimal?  @db.Decimal(12, 2)
  locked            Boolean   @default(false)
  lockedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Payment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  buyerId   String?
  buyer     Buyer?   @relation(fields: [buyerId], references: [id])
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("USD")
  method    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String            @id @default(uuid())
  tenantId         String?
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  email            String            @unique
  passwordHash     String
  name             String?
  role             String
  staffProfile     StaffProfile?
  proformas        ProformaInvoice[]
  refreshTokens    RefreshToken[]
  cifCalculations  CIFCalculation[]
  agents           Agent[]
  inquiryResponses BuyerInquiry[]    @relation("BuyerInquiryResponses")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// Additional models for buyer portal system
model BuyerNotificationSettings {
  id                    String  @id @default(cuid())
  buyerId               String  @unique
  buyer                 Buyer   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  
  // Email Notifications
  emailNewCars          Boolean @default(true)
  emailPriceDrops       Boolean @default(true)
  emailPromotions       Boolean @default(false)
  emailInquiryUpdates   Boolean @default(true)
  
  // SMS Notifications
  smsEnabled            Boolean @default(false)
  smsNewCars            Boolean @default(false)
  smsPriceDrops         Boolean @default(false)
  
  // Push Notifications
  pushEnabled           Boolean @default(true)
  pushNewCars           Boolean @default(true)
  pushPriceDrops        Boolean @default(true)
  pushPromotions        Boolean @default(false)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@map("buyer_notification_settings")
}

model BuyerInquiry {
  id              String           @id @default(cuid())
  buyerId         String
  buyer           Buyer            @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Inquiry Details
  subject         String
  message         String           @db.Text
  type            BuyerInquiryType @default(GENERAL)
  
  // Car Context (optional)
  carId           String?
  car             Car?             @relation(fields: [carId], references: [id], onDelete: SetNull)
  
  // Response
  response        String?          @db.Text
  respondedAt     DateTime?
  respondedById   String?
  respondedBy     User?            @relation("BuyerInquiryResponses", fields: [respondedById], references: [id], onDelete: SetNull)
  
  // Status
  status          InquiryStatus    @default(OPEN)
  priority        InquiryPriority  @default(MEDIUM)
  
  // Metadata
  metadata        Json?            // Additional context
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  @@index([buyerId, status])
  @@index([tenantId, status])
  @@index([carId])
  @@map("buyer_inquiries")
}

model CarView {
  id        String   @id @default(cuid())
  buyerId   String?
  buyer     Buyer?   @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  
  // Tracking
  ipAddress String?
  userAgent String?
  source    String?  // direct, search, social, etc.
  
  // Session
  sessionId String?
  duration  Int?     // seconds viewed
  
  createdAt DateTime @default(now())
  
  @@index([buyerId])
  @@index([carId])
  @@index([createdAt])
  @@map("car_views")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  buyerId         String
  buyer           Buyer       @relation(fields: [buyerId], references: [id])
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  
  // Order Details
  carId           String
  car             Car         @relation(fields: [carId], references: [id])
  
  // Pricing
  carPrice        Decimal     @db.Decimal(12, 2)
  shippingCost    Decimal?    @db.Decimal(12, 2)
  insuranceCost   Decimal?    @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  currency        String      @default("USD")
  
  // Payment
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?
  downPayment     Decimal?    @db.Decimal(12, 2)
  
  // Shipping
  shippingAddress Json?
  shippingMethod  String?
  estimatedDelivery DateTime?
  
  // Status
  status          OrderStatus @default(PENDING)
  
  // Relations
  reviews         BuyerReviews[]
  
  // Metadata
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([buyerId, status])
  @@index([tenantId, status])
  @@index([orderNumber])
  @@map("orders")
}

model BuyerReviews {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Review Details
  rating    Int      // 1-5 stars
  title     String?
  comment   String?  @db.Text
  
  // Context
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  // Status
  isVerified Boolean @default(false)
  isPublished Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([tenantId, isPublished])
  @@index([buyerId])
  @@map("buyer_reviews")
}

// Agent system models
model Referral {
  id             String        @id @default(cuid())
  agentId        String
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Referral Details
  referralCode   String        @unique
  customerEmail  String
  customerName   String
  customerPhone  String?
  
  // Car Interest
  carId          String?
  car            Car?          @relation(fields: [carId], references: [id], onDelete: SetNull)
  
  // Status Tracking
  status         ReferralStatus @default(PENDING)
  source         String        @default("DIRECT") // DIRECT, WEBSITE, SOCIAL_MEDIA, etc.
  
  // Conversion Tracking
  convertedAt    DateTime?
  saleId         String?       @unique
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  
  // Commission
  commissionRate Decimal       @default(0) @db.Decimal(5, 2)
  commissionPaid Boolean       @default(false)
  
  // Metadata
  metadata       Json?         // Additional tracking data
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  @@index([agentId, status])
  @@index([tenantId, status])
  @@index([customerEmail])
  @@map("referrals")
}

model Sale {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Sale Details
  saleNumber      String     @unique
  customerId      String
  customer        Customer   @relation(fields: [customerId], references: [id])
  carId           String
  car             Car        @relation(fields: [carId], references: [id])
  
  // Agent Assignment
  agentId         String?
  agent           Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  
  // Financial Details
  salePrice       Decimal    @db.Decimal(12, 2)
  downPayment     Decimal    @default(0) @db.Decimal(12, 2)
  financing       Boolean    @default(false)
  
  // Status
  status          SaleStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  
  // Dates
  saleDate        DateTime   @default(now())
  deliveryDate    DateTime?
  
  // Relations
  referral        Referral?
  commissions     Commission[]
  
  // Metadata
  notes           String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  @@index([tenantId, status])
  @@index([agentId])
  @@index([customerId])
  @@map("sales")
}

model Commission {
  id              String          @id @default(cuid())
  agentId         String
  agent           Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Commission Details
  saleId          String
  sale            Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  // Financial Details
  saleAmount      Decimal         @db.Decimal(12, 2)
  commissionRate  Decimal         @db.Decimal(5, 2)
  commissionAmount Decimal        @db.Decimal(12, 2)
  
  // Status & Payment
  status          CommissionStatus @default(PENDING)
  paidAt          DateTime?
  paymentMethod   String?         // BANK_TRANSFER, MOBILE_MONEY, etc.
  transactionRef  String?
  
  // Metadata
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([agentId, status])
  @@index([tenantId, status])
  @@index([saleId])
  @@map("commissions")
}


# ============================================
# Denuel Auto Frontend Environment Variables
# ============================================

# API Configuration (REQUIRED for production/static export)
# The base URL where the backend API is hosted
# Example: https://api.denuelauto.com
NEXT_PUBLIC_API_BASE_URL=

# Alternative API URL configuration (optional)
# NEXT_PUBLIC_API_URL=

# Internal API URL for server-side calls (optional, falls back to NEXT_PUBLIC_API_BASE_URL)
# API_BASE_URL=
# API_INTERNAL_URL=

# ============================================
# Optional: Feature Flags
# ============================================

# Enable/disable specific features
# NEXT_PUBLIC_ENABLE_AI=true
# NEXT_PUBLIC_ENABLE_CHAT=true
# NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ============================================
# Optional: Third-party Integrations
# ============================================

# Google Analytics
# NEXT_PUBLIC_GA_ID=

# Sentry Error Tracking
# NEXT_PUBLIC_SENTRY_DSN=

# ============================================
# Deployment Notes
# ============================================
# 
# For static export deployment (Imbra):
# 1. Set NEXT_PUBLIC_API_BASE_URL to your VPS backend URL
# 2. Run: npm run build
# 3. Deploy the 'out' folder to your static hosting
#
# For development:
# 1. Copy this file to .env.local
# 2. Set NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# 3. Run: npm run dev

{
  "name": "denuelauto-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "validate:static": "node ./scripts/verify-static.js",
    "build": "next build",
    "build:validate": "npm run validate:static && next build",
    "export": "npm run validate:static && cross-env STATIC_EXPORT=true next build && node ./scripts/export-static.js",
    "export:no-api": "node ../scripts/export_static_no_api.js",
    "start": "NODE_ENV=production node server.js",
    "start:next": "next start -p ${PORT:-3000}",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0"
  },
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@hookform/resolvers": "3.2.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "clsx": "1.2.1",
    "framer-motion": "10.12.16",
    "idb": "^7.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.210.0",
    "next": "^14.2.33",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "7.45.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.5.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "styled-components": "^5.3.10",
    "zod": "3.23.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.0.1",
    "@testing-library/react": "14.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "29.5.4",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "@types/styled-components": "5.1.26",
    "@typescript-eslint/eslint-plugin": "6.10.0",
    "@typescript-eslint/parser": "6.10.0",
    "autoprefixer": "10.4.14",
    "eslint": "8.51.0",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "jest": "29.6.1",
    "jest-environment-jsdom": "29.6.1",
    "postcss": "^8.5.6",
    
    "tailwindcss": "^3.4.12",
    "ts-jest": "29.1.0",
    "typescript": "5.1.3",
    "cross-env": "7.0.3"
  }
}

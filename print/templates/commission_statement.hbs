<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <title>Commission Statement {{statement.month}} — {{agent.name}}</title>
  <style>{{{css}}}</style>
</head>
<body>
  <header class="hdr">
    <div class="brand">
      {{#if tenant.logo_url}}<img src="{{tenant.logo_url}}" class="logo" />{{/if}}
      <div class="brand-meta">
        <h1>COMMISSION STATEMENT</h1>
        <small>{{tenant.name}} • {{statement.month}}</small>
      </div>
    </div>
    <div class="tenant">
      <strong>Agent:</strong> {{agent.name}} ({{agent.country}})<br/>
      {{agent.email}} • {{agent.phone}}
    </div>
  </header>

  <section class="cols">
    <div>
      <h3>Summary</h3>
      <p>Total Locked Commissions: <strong>{{formatMoney statement.total_amount_usd 'USD'}}</strong></p>
      <p>Status: {{statement.status}}</p>
    </div>
    <div>
      <h3>Period</h3>
      <p>{{statement.month}}</p>
    </div>
  </section>

  <section>
    <h3>Deals</h3>
    <table>
      <tr>
        <th>Date</th><th>Stock</th><th>Car</th><th>Stage</th>
        <th>Base (USD)</th><th>Rate %</th><th>Commission (USD)</th>
      </tr>
      {{#each lines}}
        <tr>
          <td>{{dateFmt this.locked_at}}</td>
          <td>{{this.stock_no}}</td>
          <td>{{this.make}} {{this.model}} {{this.year}}</td>
          <td>{{this.stage}}</td>
          <td>{{formatMoney this.base_usd 'USD'}}</td>
          <td>{{percent this.rate_pct}}</td>
          <td><strong>{{formatMoney this.commission_usd 'USD'}}</strong></td>
        </tr>
      {{/each}}
      <tr class="total">
        <td colspan="6"><strong>Total</strong></td>
        <td><strong>{{formatMoney statement.total_amount_usd 'USD'}}</strong></td>
      </tr>
    </table>
  </section>

  <footer>
    <span>Generated by Denuel • Hash: {{doc_hash}}</span>
  </footer>
</body>
</html>

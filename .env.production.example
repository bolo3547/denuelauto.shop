### Production env for Denuel Auto
# Copy to `.env.production` and replace every placeholder with real values. Do NOT commit secrets.

# Core app / URLs
NODE_ENV=production
PORT=4000
NEXT_PUBLIC_BASE_URL=https://denuel-auto.com
NEXT_PUBLIC_SITE_URL=https://denuel-auto.com
NEXT_PUBLIC_API_BASE_URL=https://api.denuel-auto.com
NEXT_PUBLIC_API_URL=https://api.denuel-auto.com
API_BASE_URL=https://api.denuel-auto.com
API_INTERNAL_URL=http://backend:4000
CORS_ORIGINS=https://denuel-auto.com,https://api.denuel-auto.com
CORS_CREDENTIALS=true

# Database / cache
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/denuel_auto?sslmode=require
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=denuel_auto
REDIS_URL=redis://:PASSWORD@HOST:6379

# Auth tokens
JWT_SECRET=replace-with-strong-secret
JWT_EXP=15m
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-secret
REFRESH_TOKEN_EXP=7d
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_DOMAIN=.denuel-auto.com
REFRESH_TOKEN_MAX_AGE=604800000
REFRESH_COOKIE_SAME_SITE=lax
HQ_JWT_SECRET=replace-with-hq-secret
HQ_JWT_EXPIRES_IN=7d
BUYER_JWT_SECRET=

# Rate limiting / security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
WEBHOOK_SECRET=
ENCRYPTION_KEY=

# Storage (S3 or Minio)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=denuel-auto-prod
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}

# Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@denuel-auto.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_PHONE_NUMBER=

# Telecom / payments (optional)
USSD_SIGNING_SECRET=
USSD_API_TASK_ID=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASEURL=https://openapi.airtel.africa
AIRTEL_SIGNING_SECRET=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_BASEURL=https://proxy.momoapi.mtn.com
MTN_MOMO_SIGNING_SECRET=
STEPUP_SECRET=
STEPUP_TEST_TOKEN=

# AI providers (optional)
# Set AI_PROVIDER or leave empty for auto-detect based on keys.
AI_PROVIDER=openai
AI_DEFAULT_PLAN=starter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AWS_BEARER_TOKEN_BEDROCK=
OPENCHAT_API_KEY=
OPENCHAT_API_URL=https://api.openchat.example/v1

# Admin API (optional)
ADMIN_API_KEY=
ADMIN_API_BASE_URL=

# Public marketing details (optional)
NEXT_PUBLIC_APP_NAME=Denuel Auto
NEXT_PUBLIC_SALES_PHONE=
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_USSD=

# Optional: container image overrides
IMAGE_BACKEND=denuel-auto-backend:latest
IMAGE_FRONTEND=denuel-auto-frontend:latest

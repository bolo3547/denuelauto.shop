# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dealership

# JWT
JWT_SECRET=super-secret
JWT_EXP=15m
REFRESH_TOKEN_SECRET=super-refresh-secret
REFRESH_TOKEN_EXP=7d
HQ_JWT_SECRET=super-hq-secret

# App
PORT=4000

# ============================================
# CORS Configuration (for split deployment)
# ============================================
# Comma-separated list of allowed frontend origins
# Example: https://denuelauto.com,https://www.denuelauto.com
CORS_ORIGINS=http://localhost:3000

# Allow credentials (cookies) in cross-origin requests
CORS_CREDENTIALS=true

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Node env
NODE_ENV=development

# Refresh token cookie options (optional)
# REFRESH_COOKIE_NAME=refreshToken
# REFRESH_COOKIE_DOMAIN=.denuel-auto.com
# REFRESH_TOKEN_MAX_AGE=604800000 # 7 days in ms
# REFRESH_COOKIE_SAME_SITE=lax

# AI (optional)
# Set AI_PROVIDER or leave empty for auto-detect based on keys.
AI_PROVIDER=mock
# Used when no active billing subscription is found (dev default is pro; prod default is starter).
AI_DEFAULT_PLAN=pro

# OpenAI (recommended: gpt-4o)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (recommended: claude-3-5-sonnet-20241022)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

{
  "name": "denuel-car-dealership",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --name init --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "seed:hq": "ts-node --transpile-only scripts/seed-hq.ts",
    "seed:demo": "ts-node --transpile-only scripts/seed-demo-tenant.ts",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "package:deploy": "node ./scripts/package-deploy.js",
    "package:deploy:frontend": "node ./scripts/package-deploy.js --frontend-only",
    "test:e2e": "playwright test",
    "generate:sitemap": "node ./scripts/generate-sitemap.ts",
    "postinstall": "npx playwright install",
    "jobs:run": "node ./dist/jobs/runner.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.513.0",
    "@prisma/client": "4.16.2",
    "axios": "^1.5.0",
    "bcrypt": "^5.0.1",
    "bullmq": "^4.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "decimal.js": "^10.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.4.1",
    "handlebars": "^4.7.7",
    "helmet": "^6.0.1",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.1",
    "puppeteer": "^20.11.0",
    "qrcode": "^1.5.1",
    "redis": "^5.10.0",
    "sharp": "^0.32.5",
    "swagger-ui-express": "^4.6.3",
    "twilio": "^5.10.6",
    "yamljs": "^0.3.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@playwright/test": "1.41.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.19",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.8",
    "@types/node": "^18.17.6",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^2.0.12",
    "eslint": "^8.46.0",
    "jest": "^29.6.2",
    "next": "14.2.0",
    "playwright": "^1.41.0",
    "prettier": "^2.8.8",
    "prisma": "4.16.2",
    "puppeteer": "^20.9.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.12",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.3",
    "archiver": "^5.4.0"
  },

  "overrides": {
    "@types/decimal.js": "7.4.3",
    "@types/handlebars": "4.0.37"
  }
}

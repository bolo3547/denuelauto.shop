deploy-package/
imbra-nodejs-deploy/
*.zip
*.tar.gz

# Tests
tests/
e2e/
*.test.ts
*.test.tsx
*.spec.ts

# Documentation (not needed in deploy)
docs/

# Config files not needed in Vercel deploy
.github/
.vscode/

  "exclude": ["tests", "prisma", "scripts", "e2e", "src/app.ts", "src/server.ts", "src/routes/**/*", "!src/routes/buyer.checkout.ts", "src/print/**/*", "src/jobs/**/*", "src/middleware/hostTenant.ts"]
}

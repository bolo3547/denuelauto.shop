{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src/min-server.ts",
    "src/routes/buyer.checkout.ts",
    "src/services/payment.service.ts",
    "src/services/warranty.service.ts",
    "src/services/loyalty.service.ts",
    "src/middleware/auth.ts",
    "src/middleware/permissions.ts",
    "src/types/**/*.ts",
    "types/**/*.d.ts"
